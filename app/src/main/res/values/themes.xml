<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FutureRealization" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/app_toolbar_background</item>
        <item name="colorPrimaryVariant">@color/system_bar_background</item>
        <item name="colorOnPrimary">@color/app_toolbar_text</item>
        <item name="colorSecondary">@color/ledger_accent</item>
        <item name="colorOnSecondary">@color/ledger_on_accent</item>
        <item name="colorAccent">@color/ledger_accent</item>
        <item name="colorControlActivated">@color/ledger_accent</item>
        <item name="colorSurface">@color/ledger_surface</item>
        <item name="colorOnSurface">@color/ledger_text</item>
        <item name="android:colorBackground">@color/ledger_background</item>
        <item name="android:windowBackground">@color/ledger_background</item>
        <item name="android:textColorPrimary">@color/ledger_text</item>
        <item name="android:textColorSecondary">@color/ledger_muted</item>
        <item name="android:textColorHint">@color/ledger_muted</item>
        <item name="android:statusBarColor">@color/system_bar_background</item>
        <item name="android:navigationBarColor">@color/ledger_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">@bool/light_navigation_icons</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Theme.FutureRealization" parent="Base.Theme.FutureRealization" />
    <style name="Theme.FutureRealization.NoteEditor" parent="Theme.FutureRealization">
        <item name="android:windowBackground">@color/notes_editor_surface</item>
        <item name="android:statusBarColor">@color/notes_editor_surface</item>
        <item name="android:navigationBarColor">@color/notes_editor_surface</item>
        <item name="android:windowLightStatusBar">@bool/notes_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/notes_light_system_bars</item>
    </style>
    <style name="Base.Theme.TransparentDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.Dialog.Transparent" parent="Base.Theme.TransparentDialog" />

    <style name="MenuTextStyleBase" parent="Theme.FutureRealization">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ledger_text</item>
        <item name="android:background">?attr/listChoiceBackgroundIndicator</item>
    </style>

    <style name="MenuTextStyle1" parent="MenuTextStyleBase">
        <item name="android:paddingTop">   11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:paddingStart">32.8dp</item>
        <item name="android:paddingEnd">  32.8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

</resources>