<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/notes_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="笔记" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/notes_ink" />
        <TextView android:id="@+id/notes_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="正在加载…" android:textSize="13sp" android:textColor="@color/notes_secondary" />
        <EditText android:id="@+id/notes_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:layout_marginBottom="18dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/notes_search" android:drawableStart="@drawable/ic_notes_search" android:drawablePadding="10dp" android:hint="搜索笔记" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:textSize="15sp" android:textColor="@color/notes_ink" android:textColorHint="@color/notes_secondary" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/notes_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="100dp" android:clipToPadding="false" android:overScrollMode="never" />
            <TextView android:id="@+id/notes_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingBottom="80dp" android:text="记录此刻的想法
点击右下角 ＋ 新建笔记" android:textSize="16sp" android:lineSpacingExtra="10dp" android:textColor="@color/notes_secondary" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/add_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="24dp" android:contentDescription="新建笔记" android:src="@drawable/ic_notes_add" app:backgroundTint="@color/notes_yellow" app:tint="@color/notes_add_ink" app:borderWidth="0dp" app:elevation="4dp" app:fabSize="normal" />
</FrameLayout>
