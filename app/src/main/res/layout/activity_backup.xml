<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ledger_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="备份全部数据"
            android:textSize="25sp" android:textStyle="bold" android:textColor="@color/ledger_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="数据保存在本机。备份包含全部账单、自定义分类、目标（含完成／放弃状态）和随身笔记。卸载应用会删除本地数据，请先导出备份。"
            android:textSize="14sp" android:lineSpacingExtra="6dp" android:textColor="@color/ledger_muted" />
        <Button android:id="@+id/export_backup" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="24dp" android:text="导出全部数据" android:textColor="@color/ledger_on_accent" app:backgroundTint="@color/ledger_accent" />
        <Button android:id="@+id/email_backup" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:text="发送备份到邮箱" android:textColor="@color/ledger_accent" app:backgroundTint="@color/ledger_soft" />
        <Button android:id="@+id/import_backup" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:text="从文件恢复到新手机" android:textColor="@color/ledger_accent" app:backgroundTint="@color/ledger_soft" />
        <Button android:id="@+id/open_xls_import" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:text="导入其他 App 账单（XLS）" android:textColor="@color/ledger_accent" app:backgroundTint="@color/ledger_soft" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="邮件备份会自动附上完整 JSON 文件。请先安装并登录邮件应用，再填写收件人、确认附件并发送。"
            android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="@color/ledger_muted" />
        <TextView android:id="@+id/backup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/ledger_card"
            android:textSize="14sp" android:lineSpacingExtra="5dp" android:textColor="@color/ledger_text" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="换手机，三步迁移数据" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ledger_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="1. 在旧手机导出备份，保存到本地“下载”目录。\n\n2. 用数据线、U盘、蓝牙或手机互传，把 JSON 文件传到新手机。\n\n3. 新手机安装本应用，先不要添加账单、目标或笔记。打开此页，选择备份文件并确认恢复。核对账单、目标状态和笔记后，再处理旧手机。"
            android:textSize="14sp" android:lineSpacingExtra="6dp" android:textColor="@color/ledger_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="备份是未加密的文件，请妥善保管。选择系统文件位置时可保存到本地，本应用不会主动上传。建议另外在电脑保留一份。"
            android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="@color/ledger_muted" />
    </LinearLayout>
</ScrollView>
