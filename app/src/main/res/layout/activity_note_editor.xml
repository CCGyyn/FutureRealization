<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/notes_editor_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/note_back" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:contentDescription="返回并保存" android:gravity="center" android:textSize="36sp" android:textColor="@color/notes_ink" android:background="?attr/selectableItemBackground" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/note_delete" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center" android:text="删除" android:textSize="15sp" android:textColor="@color/notes_secondary" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/note_save" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center" android:text="完成" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/notes_save" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingBottom="32dp">
            <EditText android:id="@id/note_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@null" android:hint="标题" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/notes_ink" android:textColorHint="@color/notes_hint" android:inputType="textCapSentences" android:maxLength="100" android:padding="0dp" />
            <TextView android:id="@+id/note_metadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="22dp" android:textSize="12sp" android:textColor="@color/notes_secondary" />
            <EditText android:id="@id/note_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="300dp" android:gravity="top" android:background="@null" android:hint="开始记录…" android:textSize="17sp" android:lineSpacingExtra="8dp" android:textColor="@color/notes_ink" android:textColorHint="@color/notes_hint" android:inputType="textMultiLine|textCapSentences" android:maxLength="10000" android:padding="0dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
