<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:background="@color/ledger_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdge="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.haibin.calendarview.CalendarView
                android:id="@+id/calendar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ledger_surface"
                app:week_background="@color/ledger_surface" app:week_text_color="@color/ledger_text" app:week_line_background="@color/ledger_border"
                app:current_month_text_color="@color/ledger_text" app:current_month_lunar_text_color="@color/ledger_muted"
                app:other_month_text_color="@color/ledger_muted" app:other_month_lunar_text_color="@color/ledger_muted"
                app:current_day_text_color="@color/ledger_accent" app:current_day_lunar_text_color="@color/ledger_accent"
                app:selected_theme_color="@color/ledger_accent" app:selected_text_color="@color/ledger_on_accent" app:selected_lunar_text_color="@color/ledger_on_accent"
                app:year_view_background="@color/ledger_surface" app:year_view_month_text_color="@color/ledger_text" app:year_view_day_text_color="@color/ledger_text" app:year_view_week_text_color="@color/ledger_muted" />

            <androidx.cardview.widget.CardView
                app:cardBackgroundColor="@color/ledger_surface"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <TextView
                            android:id="@+id/account_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:id="@+id/account_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/account_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>


</LinearLayout>