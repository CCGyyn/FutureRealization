<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/ledger_card"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/transaction_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/ledger_muted" />
    <TextView android:id="@+id/transaction_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textSize="23sp" android:textStyle="bold" android:textColor="@color/ledger_text" />
    <TextView android:id="@+id/transaction_remark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textSize="14sp" android:lineSpacingExtra="3dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/ledger_muted" />
</LinearLayout>
