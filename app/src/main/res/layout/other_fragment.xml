<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/ledger_background" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="数据备份" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/ledger_text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/ledger_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地保存 · 文件迁移"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ledger_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="导出账单、分类、目标和随身笔记，保存到本地文件。换机后可恢复目标内容、完成／放弃状态和笔记。" android:lineSpacingExtra="6dp"
            android:textSize="14sp" android:textColor="@color/ledger_muted" />
        <Button android:id="@+id/open_backup" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp"
            android:text="备份 / 恢复数据" android:textColor="@color/ledger_on_accent" app:backgroundTint="@color/ledger_accent" />
        <Button android:id="@+id/open_xls_import" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
            android:text="导入其他 App 账单（XLS）" android:textColor="@color/ledger_accent" app:backgroundTint="@color/ledger_soft" />
    </LinearLayout>
</LinearLayout>
