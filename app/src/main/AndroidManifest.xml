<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ccg.futurerealization">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_terminal"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_terminal"
        android:supportsRtl="true"
        android:theme="@style/Theme.FutureRealization">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.backupfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/backup_file_paths" />
        </provider>
        <service
            android:name=".service.DownloadService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ccg.futurerealization.DownloadService"/>
            </intent-filter>
        </service>

        <activity android:name=".view.activity.NoteEditorActivity" android:theme="@style/Theme.FutureRealization.NoteEditor" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.activity.NotesActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.activity.ReportActivity" />
        <activity android:name=".view.activity.TransactionListActivity" />
        <activity android:name=".view.activity.BackupActivity" android:screenOrientation="portrait" />
        <activity android:name=".view.activity.XlsImportActivity" android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.MsgShowDialogActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:process=":ui"
            android:theme="@style/Theme.Dialog.Transparent" />
        <activity
            android:name=".view.activity.MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.activity.CalendarActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>